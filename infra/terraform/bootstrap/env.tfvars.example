# Copy to dev.tfvars, stag.tfvars, or prod.tfvars and replace the values.
# The real *.tfvars files are git-ignored.

# One of: dev, stag, prod. Must match the filename.
environment = "dev"

# Region for the AWS provider and the SES identity.
aws_region = "eu-west-2"

# Full IAM names, including any environment prefix.
terraform_role_name   = "dev-github-actions-terraform-role"
terraform_policy_name = "dev-github-actions-terraform-role-policy"
lambda_role_name      = "dev-portfolio-role-lambda-exec"
lambda_policy_name    = "dev-portfolio-role-lambda-exec-policy"

# Website hosting bucket the deployment role may manage.
site_bucket_name = "example-dev-site-bucket"

# State bucket for this bootstrap configuration (keep aligned with -StateBucket).
bootstrap_state_bucket_name = "example-state-bucket"

# State bucket and key for the main infrastructure.
site_state_bucket_name = "example-state-bucket"
site_state_key         = "terraform/portfolio/dev/infra/terraform.tfstate"

# Repository whose GitHub Actions may assume the deployment role.
github_owner      = "example-owner"
github_repository = "example-repo"

# Addresses the Lambda role may send from. Must belong to the verified SES domain.
ses_from_email            = "dev-portfolio@example.com"
ses_auto_reply_from_email = "dev-autoreply@example.com"
